<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the upstream rule methods (Extracted.cs, generated) against stubs to write golden vectors. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0414;CS0649;CS0169;CS0219;CS0108</NoWarn>
  </PropertyGroup>
</Project>
